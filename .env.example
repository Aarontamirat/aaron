# Optional. Without these values, the form offers a direct email alternative.
RESEND_API_KEY=
# A sender on your verified Resend domain, e.g. Aaron Portfolio <contact@example.com>
CONTACT_FROM_EMAIL=
# Optional recipient override; defaults to the email in src/content/portfolio.ts
CONTACT_TO_EMAIL=
# Optional canonical production URL override (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://aarontamirat.vercel.app
# Optional Upstash Redis REST credentials for a shared, durable rate limiter.
# The default limiter works within a single server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
